<div id="map297088" style="width: 400px; height: 250px"></div>

<script>
  // Creating map options
  var mapOptions = {
    center: [40.7836,-77.8183],
    zoom: 13
  }

  // Creating a map object
  var map297088 = new L.map('map297088', mapOptions);

  // Creating a Layer object
  var layer = new L.TileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');

  // Here goes all the stuff specific to this map.
  var route = new L.GPX('maps/gpx/bike/south_atherton.gpx', {
    async: true,
    marker_options: {
      startIconUrl: false,
      endIconUrl: false,
      shadowUrl: false,
    },
    polyline_options: {
      color: 'blue',
      weight: 5,
      opacity: 0.7,
    },
  }).addTo(map297088);


  // Adding layer to the map
  map297088.addLayer(layer);

</script>
