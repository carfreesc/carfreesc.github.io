<div id="map359953" style="width: 400px; height: 250px"></div>

<script>
  // Creating map options
  var mapOptions = {
    center: [40.7891,-77.8927],
    zoom: 13
  }

  // Creating a map object
  var map359953 = new L.map('map359953', mapOptions);

  // Creating a Layer object
  var layer = new L.TileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');

  // Here goes all the stuff specific to this map.
  var route = new L.GPX('maps/gpx/bike/circleville_to_psu.gpx', {
    async: true,
    marker_options: {
      startIconUrl: false,
      endIconUrl: false,
      shadowUrl: false,
    },
    polyline_options: {
      color: 'blue',
      weight: 5,
      opacity: 0.7,
    },
  }).addTo(map359953);


  // Adding layer to the map
  map359953.addLayer(layer);

</script>
