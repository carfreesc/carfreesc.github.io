<div id="map241919" style="width: 600px; height: 300px"></div>

<script>
  // Creating map options
  var mapOptions = {
    center: [40.79444,-77.861604],
    zoom: 12
  }

  // Creating a map object
  var map241919 = new L.map('map241919', mapOptions);

  // Creating a Layer object
  var layer = new L.TileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');

  // Here goes all the stuff specific to this map.
  var route = new L.GPX('maps/gpx/cata/cc_approx.gpx', {
    async: true,
    marker_options: {
      startIconUrl: false,
      endIconUrl: false,
      shadowUrl: false,
    },
    polyline_options: {
      color: 'blue',
      weight: 5,
      opacity: 0.7,
    },
  }).addTo(map241919);
  var route = new L.GPX('maps/gpx/cata/rx_approx.gpx', {
    async: true,
    marker_options: {
      startIconUrl: false,
      endIconUrl: false,
      shadowUrl: false,
    },
    polyline_options: {
      color: 'red',
      weight: 5,
      opacity: 0.7,
    },
  }).addTo(map241919);


  // Adding layer to the map
  map241919.addLayer(layer);

</script>
