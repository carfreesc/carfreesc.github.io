<div id="map696633" style="width: 600px; height: 300px"></div>

<script>
  // Creating map options
  var mapOptions = {
    center: [40.79444,-77.861604],
    zoom: 13
  }

  // Creating a map object
  var map696633 = new L.map('map696633', mapOptions);

  // Creating a Layer object
  var layer = new L.TileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');

  // Here goes all the stuff specific to this map.
  var marker = new L.marker([40.79557, -77.859]).addTo(map696633).bindPopup("Way Fruit Farm Downtown Market and Cafe");
  var marker = new L.marker([40.7917204, -77.857604]).addTo(map696633).bindPopup("State College International Market");
  var marker = new L.marker([40.7814996, -77.8532859]).addTo(map696633).bindPopup("Weis Markets");


  // Adding layer to the map
  map696633.addLayer(layer);

</script>
