<div id="map" style="width: 600px; height: 150px"></div>

<script>
  // Creating map options
  var mapOptions = {
    center: [40.7848927,-77.8685289],
    zoom: 15
  }

  // Creating a map object
  var map = new L.map('map', mapOptions);

  // Creating a Layer object
  var layer = new L.TileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');

  // Here goes all the stuff specific to this map.
    var marker = L.marker([40.79557, -77.859]).addTo(map).bindPopup("Way Fruit Farm Downtown Market and Cafe")
  var marker = L.marker([40.7917204, -77.857604]).addTo(map).bindPopup("State College International Market")
  var marker = L.marker([40.7814996, -77.8532859]).addTo(map).bindPopup("Weis Markets")


  // Adding layer to the map
  map.addLayer(layer);

</script>
