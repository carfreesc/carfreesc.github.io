<div id="map224802" style="width: 400px; height: 250px"></div>

<script>
  // Creating map options
  var mapOptions = {
    center: [40.7754,-77.8629],
    zoom: 13
  }

  // Creating a map object
  var map224802 = new L.map('map224802', mapOptions);

  // Creating a Layer object
  var layer = new L.TileLayer('http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');

  // Here goes all the stuff specific to this map.
  var route = new L.GPX('maps/gpx/bike/orchard.gpx', {
    async: true,
    marker_options: {
      startIconUrl: false,
      endIconUrl: false,
      shadowUrl: false,
    },
    polyline_options: {
      color: 'blue',
      weight: 5,
      opacity: 0.7,
    },
  }).addTo(map224802);


  // Adding layer to the map
  map224802.addLayer(layer);

</script>
